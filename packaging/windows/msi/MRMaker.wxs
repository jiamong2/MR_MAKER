<!--
  MR MAKER for ui.clover - Windows Installer (MSI) 패키지 (WiX Toolset v5 + WixToolset.UI.wixext)

  브라우저로 받은 낯선 .exe 설치 파일을 격리하는 백신(V3 등)이 있어, Windows 자체 설치 관리자(msiexec)가 여는
  MSI 로 배포한다.

  - 설치 화면(한국어): 시작 → 이용 안내 → 설치 항목(바탕화면 바로가기 선택) · 설치 위치 → 설치 → 완료(바로 실행)
  - 기본 위치: 사용자 계정 %LOCALAPPDATA%\Programs\MR MAKER (MSI) (관리자 권한 불필요)
  - 같은 UpgradeCode 로 새 버전을 설치하면 이전 버전을 자동으로 교체
  - 프로그램 안의 [업데이트](msiexec /qb, 화면 없이 진행 표시만)는 설치 후 자동으로 다시 실행

  빌드 (scripts/build.py 가 호출):
    wix build MRMaker.wxs -arch x64 -ext WixToolset.UI.wixext -culture ko-KR
      -d Version=1.2.9 -d SourceDir=<dist\MRMaker 절대경로> -d IconPath=<icon.ico> -d AssetsDir=<이 폴더 절대경로>
      [-d EmbedCab=no -d MediaSize=1800 -d CabPrefix=MRMaker-1.2.9-windows-x64-cuda-]   ← 2GB 넘는 CUDA 버전
      -o out.msi
-->
<?ifndef EmbedCab?><?define EmbedCab = "yes"?><?endif?>
<?ifndef MediaSize?><?define MediaSize = "1800"?><?endif?>
<?ifndef CabPrefix?><?define CabPrefix = "MRMaker-"?><?endif?>
<?ifndef Compression?><?define Compression = "high"?><?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="MR MAKER for ui.clover" Manufacturer="ui.clover" Version="$(Version)" Language="1042"
           Codepage="949" UpgradeCode="6FA73F04-BFA9-4E99-8B94-39B539B8F37D" Scope="perUser" Compressed="yes">

    <!-- 새 버전: 기존 버전을 자동으로 교체 / 같은 버전: 다시 설치(덮어쓰기) / 이전 버전: 설치하지 않음 -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="이미 더 최신 버전의 MR MAKER가 설치되어 있어 이전 버전은 설치하지 않습니다." />
<?if $(EmbedCab) = "yes" ?>
    <MediaTemplate EmbedCab="yes" CompressionLevel="$(Compression)" />
<?else?>
    <!-- MSI 파일 하나는 2GB 를 넘을 수 없어 외부 .cab 여러 개로 나눔 (.msi 와 같은 폴더에 두고 실행) -->
    <MediaTemplate EmbedCab="no" CompressionLevel="$(Compression)" MaximumUncompressedMediaSize="$(MediaSize)"
                   CabinetTemplate="$(CabPrefix){0}.cab" />
<?endif?>

    <Icon Id="AppIcon" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="MR MAKER (MSI)" />
      </Directory>
    </StandardDirectory>

    <!-- 설치 항목 -->
    <Feature Id="Main" Title="MR MAKER" Description="MR MAKER 프로그램과 시작 메뉴 바로가기 (필수)" Level="1"
             AllowAbsent="no" ConfigurableDirectory="INSTALLFOLDER" Display="expand">
      <Files Directory="INSTALLFOLDER" Include="$(SourceDir)\**" />
      <ComponentRef Id="StartMenuShortcut" />
      <Feature Id="DesktopShortcutFeature" Title="바탕화면 바로가기" Description="바탕화면에 MR MAKER 바로가기를 만듭니다."
               Level="1">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
    </Feature>

    <!-- 시작 메뉴 / 바탕화면 바로가기 (사용자 프로필 설치라 HKCU 값을 키 경로로 사용).
         아이콘은 MRMaker.exe 에 들어 있는 것을 그대로 씀: Icon 속성을 쓰면 설치 관리자 캐시 폴더의 아이콘을 가리켜,
         다시 설치·업데이트 후 작업 표시줄에 고정한 아이콘이 빈칸으로 바뀜 -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="3E7B1C52-6A0D-4C7E-9E1B-2F4A8D6C0B11">
        <Shortcut Id="StartMenuLnk" Name="MR MAKER" Description="MR MAKER for ui.clover"
                  Target="[INSTALLFOLDER]MRMaker.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\MusicSeparator\Installer" Name="msi_startmenu" Type="integer"
                       Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="8C2D4F61-1B3E-4A9C-B7D5-6E0F2A1C9D22">
        <Shortcut Id="DesktopLnk" Name="MR MAKER" Description="MR MAKER for ui.clover"
                  Target="[INSTALLFOLDER]MRMaker.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\MusicSeparator\Installer" Name="msi_desktop" Type="integer"
                       Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- 설치 화면 (한국어, 클로버 로고) -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(AssetsDir)\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(AssetsDir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(AssetsDir)\dialog.bmp" />

    <!-- 설치 후 실행: 일반 설치는 완료 화면의 체크박스, 프로그램 안 [업데이트](/qb)는 자동 -->
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]MRMaker.exe&quot;"
                  Execute="immediate" Return="asyncNoWait" Impersonate="yes" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="MR MAKER 바로 실행하기" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE AND UILevel = 3" />
    </InstallExecuteSequence>
  </Package>
</Wix>
