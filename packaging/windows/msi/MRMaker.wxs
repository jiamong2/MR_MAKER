<!--
  MR MAKER for ui.clover - Windows Installer (MSI) 패키지 (WiX Toolset v5)

  setup.exe(Inno Setup) 와 같은 프로그램을 MSI 형식으로 담는다. 브라우저로 받은 낯선 .exe 설치 파일을
  격리하는 백신(V3 등)이 있어, Windows 자체 설치 관리자(msiexec)가 여는 MSI 를 함께 제공한다.

  - 사용자 계정에 설치 (관리자 권한 불필요): %LOCALAPPDATA%\Programs\MR MAKER (MSI)
  - 같은 UpgradeCode 로 새 버전을 설치하면 이전 버전을 자동으로 교체
  - 설치가 끝나면 프로그램을 바로 실행 (조용한 설치 /qn 에서는 실행하지 않음)

  빌드: wix build MRMaker.wxs -arch x64 -sval -d Version=1.2.8 -d SourceDir=dist\MRMaker -d IconPath=assets\icon.ico -o out.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="MR MAKER for ui.clover" Manufacturer="ui.clover" Version="$(Version)"
           UpgradeCode="6FA73F04-BFA9-4E99-8B94-39B539B8F37D" Scope="perUser" Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of MR MAKER is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="MR MAKER (MSI)" />
      </Directory>
    </StandardDirectory>

    <!-- 프로그램 폴더 전체 (PyInstaller 결과물) -->
    <Files Directory="INSTALLFOLDER" Include="$(SourceDir)\**" />

    <!-- 시작 메뉴 / 바탕화면 바로가기 (사용자 프로필 설치라 HKCU 값을 키 경로로 사용) -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="3E7B1C52-6A0D-4C7E-9E1B-2F4A8D6C0B11">
        <Shortcut Id="StartMenuLnk" Name="MR MAKER" Description="MR MAKER for ui.clover"
                  Target="[INSTALLFOLDER]MRMaker.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\MusicSeparator\Installer" Name="msi_startmenu" Type="integer"
                       Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="8C2D4F61-1B3E-4A9C-B7D5-6E0F2A1C9D22">
        <Shortcut Id="DesktopLnk" Name="MR MAKER" Description="MR MAKER for ui.clover"
                  Target="[INSTALLFOLDER]MRMaker.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\MusicSeparator\Installer" Name="msi_desktop" Type="integer"
                       Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- 설치 완료 후 실행 (화면이 있는 설치에서만) -->
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]MRMaker.exe&quot;"
                  Execute="immediate" Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE AND UILevel &gt;= 3" />
    </InstallExecuteSequence>
  </Package>
</Wix>
